    {
     "id": "suite-green",
     "pattern": "# (\\d+) green",
     "source": {
      "argv": [
       "python3",
       "-c",
       "import ast,glob;print(sum(1 for f in glob.glob('formal-trika/tests/test_*.py') for n in ast.walk(ast.parse(open(f).read())) if isinstance(n,ast.FunctionDef) and n.name.startswith('test_')))"
      ],
      "pattern": "(\\d+)",
      "timeout": 60
     },
     "note": "count of test methods (deterministic); CI proves they pass"
    },
    {
     "id": "evidence-theorems",
     "pattern": "(\\d+) theorems /",
     "source": {
      "argv": [
